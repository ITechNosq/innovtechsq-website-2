# =====================================================
# INNOVTECH SQ LEAD API - ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this to .env and fill in your values
# WARNING: Never commit .env to version control!

# ============== DATABASE ==============
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/leads_db

# ============== SECURITY (CRITICAL) ==============
# Client API key - Use this in your website frontend
# Format: Use a long, random string (at least 32 characters)
API_KEY=your-32-character-random-client-api-key-here

# Admin API key - Use this for admin panel access (DIFFERENT from client key!)
# WARNING: This should be a completely different key!
ADMIN_API_KEY=your-32-character-random-admin-api-key-here

# JWT secret - For future JWT authentication
JWT_SECRET=your-jwt-secret-change-this-in-production

# ============== EMAIL ==============
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# Admin email - Where lead notifications will be sent
ADMIN_EMAIL=your-admin-email@gmail.com

# ============== RATE LIMITING ==============
# Redis URL for distributed rate limiting
# Format: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# Requests per minute allowed
RATE_LIMIT_PER_MINUTE=10

# ============== CORS (CRITICAL) ==============
# Allowed origins - COMMA SEPARATED, NO WILDCARDS!
# Example: https://yourdomain.com,https://www.yourdomain.com
# IMPORTANT: You must configure this or CORS will block all requests!
CORS_ORIGINS=https://innovtechnosq.co.in

# ============== APP SETTINGS ==============
APP_NAME=InnovTech Sq Lead API
APP_VERSION=1.0.0
DEBUG=False

# ============== PAGINATION ==============
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# ============== DUPLICATE PROTECTION ==============
DUPLICATE_WINDOW_HOURS=24
